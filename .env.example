NODE_ENV=development
PORT=3000

DB_USER=fintech
DB_PASSWORD=fintech
DB_NAME=fintech
DB_PORT=5432
DATABASE_URL=postgresql://fintech:fintech@localhost:5432/fintech?schema=public

# One or more "<clientId>:<sha256 hex of its secret>", comma separated.
# Only the hash belongs here; the secret itself is held by the client and stored nowhere.
API_CLIENTS=<clientId>:<sha256 hex of its secret>

# One or more "<host>:<port>", comma separated.
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
